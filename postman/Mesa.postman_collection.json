{
  "info": {
    "name": "Mesa — Restaurant Review API (IFQ636 A2)",
    "_postman_id": "b3f1c2d4-mesa-0000-0000-restaurantreview",
    "description": "End-to-end API tests for the Mesa restaurant review platform.\n\nCovers auth (register/login/profile), restaurant CRUD, review CRUD, owner response, and admin moderation — including error paths (401/403/404/409/400).\n\nThe collection runs top-to-bottom (Newman-friendly): it registers a diner, logs in as admin + diner, captures the JWTs and created IDs into collection variables, exercises every endpoint, then cleans up by deleting the test restaurant (cascading its reviews).\n\nVariables it sets automatically: diner_token, admin_token, dinerEmail, restaurantId, restaurantSlug, reviewId.\n\nRequires a running backend (default http://localhost:5001) seeded with the admin user admin@mesa.test / admin1234 (see backend/seed.js).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "adminEmail", "value": "admin@mesa.test" },
    { "key": "adminPassword", "value": "admin1234" },
    { "key": "dinerEmail", "value": "" },
    { "key": "dinerPassword", "value": "diner1234" },
    { "key": "diner_token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "restaurantId", "value": "" },
    { "key": "restaurantSlug", "value": "" },
    { "key": "reviewId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Diner (POST /api/auth/register)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a unique diner email so the run is repeatable.",
                  "const email = `diner_${Date.now()}@mesa.test`;",
                  "pm.collectionVariables.set('dinerEmail', email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status code is 201 (Created)', () => pm.response.to.have.status(201));",
                  "pm.test('Content-Type is present', () => pm.response.to.have.header('Content-Type'));",
                  "pm.test('Response time is under 1000ms', () => pm.expect(pm.response.responseTime).to.be.below(1000));",
                  "pm.test('Body returns id, email and token', () => {",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('email');",
                  "  pm.expect(json).to.have.property('token').that.is.a('string');",
                  "});",
                  "if (json.token) { pm.collectionVariables.set('diner_token', json.token); console.log('Saved diner_token'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Diner\",\n  \"email\": \"{{dinerEmail}}\",\n  \"password\": \"{{dinerPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
